# Copy this file to .env, then replace every value with unique local-only values.
# Never use these sample values in shared or production environments.
JWT_SECRET=replace-with-at-least-32-random-bytes-for-local-development
METRICS_AUTH_USERNAME=neonrush-monitoring
METRICS_AUTH_PASSWORD=replace-with-a-unique-local-monitoring-password
POSTGRES_PASSWORD=replace-with-a-unique-local-postgres-password
REDIS_PASSWORD=replace-with-a-unique-local-redis-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-local-grafana-password
