; ─────────────────────────────────────────────────────────────────
; Root — GameplayScene node orchestrates all subsystems
; ─────────────────────────────────────────────────────────────────
[node name="GameplayScene" type="Node3D"]

; ─── Run Manager (gameplay lifecycle orchestration) ───
[node name="RunManager" type="Node" parent="."]
script = ExtResource("9_run")

; ─── Obstacle Spawner ───
[node name="ObstacleSpawner" type="Node3D" parent="."]
script = ExtResource("8_obs")

; ─── Power-up Manager ───
[node name="PowerupManager" type="Node" parent="."]
script = ExtResource("10_pwr")

; ─── Track Generator ───
[node name="TrackGenerator" type="Node3D" parent="."]
script = ExtResource("1_tgen")

; ─── Lighting ───────────────────────────────────────────────────
[node name="WorldEnvironment" type="WorldEnvironment" parent="."]

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866, -0.433, 0.25, 0.0, 0.5, 0.866, -0.5, -0.75, 0.433, 0, 10, 0)
light_color = Color(0.95, 0.9, 1.0, 1)
light_energy = 1.5
shadow_enabled = true

; ─── Player ─────────────────────────────────────────────────────
[node name="Player" type="CharacterBody3D" parent="."]
script = ExtResource("2_runner")
lane_positions = [-2.0, 0.0, 2.0]
lane_switch_speed = 10.0
jump_force = 12.0
gravity_multiplier = 2.5
slide_duration = 0.8
initial_run_speed = 10.0

[node name="PlayerAnimation" type="Node" parent="Player"]
script = ExtResource("3_panim")
animation_tree_path = NodePath("../AnimationTree")
animation_player_path = NodePath("../AnimationPlayer")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Player"]
shape = CapsuleShape3D

[node name="CollisionDetector" type="Area3D" parent="Player"]
collision_layer = 2
collision_mask = 4

[node name="CollisionShape3D" type="CollisionShape3D" parent="Player/CollisionDetector"]
shape = CapsuleShape3D

[node name="PlayerCollision" type="Node" parent="Player"]
script = ExtResource("4_pcol")
detector_path = NodePath("../CollisionDetector")
invincibility_duration = 1.5

[node name="CoinMagnet" type="Node" parent="Player"]
script = ExtResource("11_mag")
magnet_radius = 6.0
attract_speed = 20.0

[node name="MeshInstance3D" type="MeshInstance3D" parent="Player"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
mesh = CapsuleMesh

; Placeholder material — replace with character skin
[node name="AnimationPlayer" type="AnimationPlayer" parent="Player"]

; ─── Swipe Input (sibling of Player — not nested) ───────────────
[node name="SwipeInputController" type="Node" parent="."]
script = ExtResource("5_swipe")

; ─── Follow Camera ──────────────────────────────────────────────
[node name="Camera3D" type="Camera3D" parent="."]
script = ExtResource("6_cam")
